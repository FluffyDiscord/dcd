# .env.deploy.infra — environment for the INFRA side containers (mariadb + meilisearch) ONLY.
# Copy to .env.deploy.infra on the server, fill in, chmod 0600. Docker env-file format (see .app).
# Kept separate from .env.deploy.app so the DB root / Meili master keys never enter app containers.

# MARIADB_USER/PASSWORD/DATABASE MUST equal the user/pass/db in DATABASE_URL (.env.deploy.app).
MARIADB_ROOT_PASSWORD=__root_password__
MARIADB_DATABASE=app
MARIADB_USER=app
MARIADB_PASSWORD=__db_password__

# The app's MEILISEARCH_API_KEY (.env.deploy.app) may be this master key, or a scoped key derived from it.
MEILI_MASTER_KEY=__meili_key__
MEILI_ENV=production
